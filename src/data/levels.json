{
  "levels": [
    {
      "id": 1,
      "title": "Código de Acceso",
      "description": "Ingresa tu código de seguridad para entrar al laboratorio. El código debe tener exactamente 4 dígitos y no debe ser '0000'.",
      "functionName": "isValidAccessCode",
      "starterCode": "function isValidAccessCode(code) {\n  return false;\n}",
      "exampleTests": [
        "expect(isValidAccessCode('1234')).toBe(true);",
        "expect(isValidAccessCode('0000')).toBe(false);",
        "expect(isValidAccessCode('123')).toBe(false);"
      ],
      "expectedSolution": "function isValidAccessCode(code) {\n  return code.length === 4 && code !== '0000' && /^\\d{4}$/.test(code);\n}",
      "hiddenTests": [
        {"input": "9999", "expected": true},
        {"input": "0001", "expected": true},
        {"input": "12345", "expected": false},
        {"input": "abcd", "expected": false},
        {"input": "12a4", "expected": false}
      ]
    },
    {
      "id": 2,
      "title": "Validación de Muestra",
      "description": "Verificar que el código de muestra tenga el formato correcto (3 letras mayúsculas + 4 dígitos).",
      "functionName": "isValidSampleCode",
      "starterCode": "function isValidSampleCode(code) {\n  return false;\n}",
      "exampleTests": [
        "expect(isValidSampleCode('ABC1234')).toBe(true);",
        "expect(isValidSampleCode('abc1234')).toBe(false);",
        "expect(isValidSampleCode('AB12345')).toBe(false);"
      ],
      "expectedSolution": "function isValidSampleCode(code) {\n  const regex = /^[A-Z]{3}\\d{4}$/;\n  return regex.test(code);\n}",
      "hiddenTests": [
        {"input": "XYZ9999", "expected": true},
        {"input": "AAA0000", "expected": true},
        {"input": "ABCD123", "expected": false},
        {"input": "AB123", "expected": false},
        {"input": "ABC12345", "expected": false}
      ]
    },
    {
      "id": 3,
      "title": "Cálculo de Temperatura",
      "description": "Convertir temperatura de Celsius a Fahrenheit.",
      "functionName": "celsiusToFahrenheit",
      "starterCode": "function celsiusToFahrenheit(celsius) {\n  return 0;\n}",
      "exampleTests": [
        "expect(celsiusToFahrenheit(0)).toBe(32);",
        "expect(celsiusToFahrenheit(100)).toBe(212);",
        "expect(celsiusToFahrenheit(-40)).toBe(-40);"
      ],
      "expectedSolution": "function celsiusToFahrenheit(celsius) {\n  return (celsius * 9/5) + 32;\n}",
      "hiddenTests": [
        {"input": 25, "expected": 77},
        {"input": -10, "expected": 14},
        {"input": 37, "expected": 98.6},
        {"input": 10, "expected": 50},
        {"input": -273.15, "expected": -459.67}
      ]
    },
    {
      "id": 4,
      "title": "Verificación de Presión",
      "description": "Determinar el estado de presión según el rango: LOW (< 30), NORMAL (30-70), HIGH (> 70).",
      "functionName": "getPressureStatus",
      "starterCode": "function getPressureStatus(pressure) {\n  return 'UNKNOWN';\n}",
      "exampleTests": [
        "expect(getPressureStatus(20)).toBe('LOW');",
        "expect(getPressureStatus(50)).toBe('NORMAL');",
        "expect(getPressureStatus(80)).toBe('HIGH');"
      ],
      "expectedSolution": "function getPressureStatus(pressure) {\n  if (pressure < 30) return 'LOW';\n  if (pressure > 70) return 'HIGH';\n  return 'NORMAL';\n}",
      "hiddenTests": [
        {"input": 0, "expected": "LOW"},
        {"input": 29, "expected": "LOW"},
        {"input": 30, "expected": "NORMAL"},
        {"input": 70, "expected": "NORMAL"},
        {"input": 71, "expected": "HIGH"},
        {"input": 100, "expected": "HIGH"}
      ]
    },
    {
      "id": 5,
      "title": "Filtrado de Datos",
      "description": "Filtrar valores anómalos (outliers) mayores a 3 desviaciones estándar de la media.",
      "functionName": "filterOutliers",
      "starterCode": "function filterOutliers(data) {\n  return [];\n}",
      "exampleTests": [
        "expect(filterOutliers([10, 12, 11, 100, 10, 12])).toEqual([10, 12, 11, 10, 12]);",
        "expect(filterOutliers([1, 2, 3, 4, 5])).toEqual([1, 2, 3, 4, 5]);",
        "expect(filterOutliers([])).toEqual([]);"
      ],
      "expectedSolution": "function filterOutliers(data) {\n  if (data.length === 0) return [];\n  const mean = data.reduce((a, b) => a + b, 0) / data.length;\n  const variance = data.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / data.length;\n  const stdDev = Math.sqrt(variance);\n  const threshold = 3 * stdDev;\n  return data.filter(value => Math.abs(value - mean) <= threshold);\n}",
      "hiddenTests": [
        {"input": [1, 1, 1, 1, 1000], "expected": [1, 1, 1, 1]},
        {"input": [5, 5, 5, 5], "expected": [5, 5, 5, 5]},
        {"input": [0, 0, 0, 10], "expected": [0, 0, 0, 10]},
        {"input": [10, -10, 10, -10], "expected": [10, -10, 10, -10]},
        {"input": [100], "expected": [100]}
      ]
    }
  ]
}
